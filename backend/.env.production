# Production Environment Configuration
# Copy this file to .env and update with your production values

# Environment
ENVIRONMENT=production
DEBUG=false

# Server Configuration
PORT=${PORT}
HOST=0.0.0.0

# CORS Configuration (Update with your production domain)
CORS_ORIGINS=https://your-frontend-domain.herokuapp.com,https://your-custom-domain.com

# Database Configuration (Heroku Postgres)
DATABASE_URL=${DATABASE_URL}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis Configuration (Heroku Redis or Redis Cloud)
REDIS_URL=${REDIS_URL}
REDIS_POOL_SIZE=20
REDIS_RETRY_ON_TIMEOUT=true

# API Keys (Set these in Heroku Config Vars)
GEMINI_API_KEY=${GEMINI_API_KEY}
SECRET_KEY=${SECRET_KEY}

# Security Settings
API_KEY_ROTATION_DAYS=30
MAX_CONCURRENT_USERS=100
RATE_LIMIT_PER_MINUTE=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Performance Settings
WEBSOCKET_PING_TIMEOUT=60
WEBSOCKET_PING_INTERVAL=25
SUBMISSION_TIMEOUT_SECONDS=30