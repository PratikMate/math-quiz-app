{
  "name": "Math Quiz App",
  "description": "Real-time competitive math quiz application",
  "repository": "https://github.com/PratikMate/math-quiz-app",
  "keywords": ["python", "fastapi", "socketio", "math", "quiz"],
  "env": {
    "SECRET_KEY": {
      "description": "Secret key for the application",
      "value": "math-quiz-secret-key-production-2025"
    },
    "CORS_ORIGINS": {
      "description": "Allowed CORS origins",
      "value": "*"
    },
    "DEBUG": {
      "description": "Debug mode",
      "value": "false"
    }
  },
  "addons": [
    "heroku-postgresql:essential-0",
    "heroku-redis:mini"
  ],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
